{
  "expo": {
    "name": "Omega",
    "slug": "counterapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/appicon.jpg",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymtracker.app",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.omega.tracker",
      "versionCode": 2,
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# SQLite JSI bindings are resolved by name from native code.\n-keep class expo.modules.sqlite.** { *; }"
          }
        }
      ],
      "./plugins/withAndroidDebugSymbolLevel"
    ],
    "scheme": "gymtracker",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8289af09-42e6-4c60-9cec-de12005ed2b8"
      }
    },
    "owner": "ronnierobert"
  }
}
